{
  "responseOverrides": {
    "404": { "rewrite": "/404.html", "statusCode": 404 }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "routes": [
    { "route": "/downloads/*", "headers": { "Content-Disposition": "attachment", "Cache-Control": "public, max-age=3600" } },
    { "route": "/css/*", "headers": { "Cache-Control": "public, max-age=86400" } },
    { "route": "/js/*", "headers": { "Cache-Control": "public, max-age=3600" } }
  ],
  "mimeTypes": {
    ".zip": "application/zip",
    ".ps1": "text/plain"
  }
}
